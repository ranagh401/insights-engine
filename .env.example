# 1Platform - Insights Service (sample configuration)

# Platform-wide config
ONEPLATFORM_ENVIRONMENT=development
ONEPLATFORM_DEBUG=false

# Database (PostgreSQL for metadata / config)
ONEPLATFORM_DATABASE__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oneplatform_configure
ONEPLATFORM_DATABASE__SCHEMA=insights

# Redis
ONEPLATFORM_REDIS__URL=redis://localhost:6379/0

# JWT
ONEPLATFORM_JWT__JWT_SECRET=change-me
ONEPLATFORM_JWT__ALGORITHM=HS256
ONEPLATFORM_JWT__ISSUER=1Platform

# Message Broker
ONEPLATFORM_MESSAGE_BROKER__URL=amqp://guest:guest@localhost:5672/

# Service
ONEPLATFORM_SERVICE__NAME=ms-insights-crm
ONEPLATFORM_SERVICE__VERSION=1.0.0
ONEPLATFORM_SERVICE__PORT=8014
ONEPLATFORM_SERVICE__GRPC_PORT=50055

# Insights-Specific Configuration
# SQL Server (AdventureWorks backend)
ONEPLATFORM_SQLSERVER__CONN_STR=Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-sql-server.database.windows.net,1433;Database=adventureWorks2022;Uid=sqladmin;Pwd=your-password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# Databricks (RGM backend)
ONEPLATFORM_DATABRICKS__HOST=https://<your-workspace>.azuredatabricks.net
ONEPLATFORM_DATABRICKS__TOKEN=your-databricks-token
ONEPLATFORM_DATABRICKS__WAREHOUSE_ID=your-warehouse-id
ONEPLATFORM_DATABRICKS__CATALOG=sales_detail
ONEPLATFORM_DATABRICKS__SCHEMA_NAME=insights_portal

# Optional: max rows written per signal per (period × KPI job) when Insights.ConfigSignals.TopN is NULL.
# Thresholds still decide *who* qualifies; without TopN every matching customer/month row becomes a signal.
# ONEPLATFORM_SIGNAL_DEFAULT_TOP_N=50

# Azure OpenAI (for LLM insights)
ONEPLATFORM_OPENAI__API_KEY=your-openai-key
ONEPLATFORM_OPENAI__ENDPOINT=https://<your-endpoint>.openai.azure.com/
ONEPLATFORM_OPENAI__API_VERSION=2024-06-01
ONEPLATFORM_OPENAI__DEPLOYMENT=gpt-4o
ONEPLATFORM_OPENAI__TEMPERATURE=0.2

# ── Power BI DAX engine (required for PBI-backed KPIs / signals) ─────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
PBI_WORKSPACE_ID=
PBI_DATASET_ID=
DATE_TABLE_NAME=Calender
DATE_COLUMN_NAME=Calender Date
# Optional: POST /pbi/data/fetch overrides for week enrichment (Week_YearWeek / Week_Start_Date / Week_End_Date).
# If all four are unset, defaults apply when the week dimension’s table matches DATE_TABLE_NAME:
# Week Number (+ Week Start Date + Week End Date); sort is omitted from DAX when it is already the week grain.
# INSIGHTS_FETCH_WEEK_TABLE=Calender
# INSIGHTS_FETCH_WEEK_SORT_COLUMN=Week Number
# INSIGHTS_FETCH_WEEK_START_COLUMN=Week Start Date
# INSIGHTS_FETCH_WEEK_END_COLUMN=Week End Date
POSTGRES_DSN=
# CRM narrative insights target table (schema insights). Created on startup if missing.
MAIN_INSIGHTS_TABLE=maininsightscrm
PBI_MAX_CONCURRENT_QUERIES=5
PBI_RETRY_MAX_ATTEMPTS=3
# Bulk WHY DAX can run >120s; httpx read timeout (seconds).
PBI_DAX_READ_TIMEOUT_SECONDS=600
# PBI_MAX_REQUESTS_PER_MINUTE=80

# Logging / throughput (Renuity PBI trigger)
# INSIGHTS_LOG_SQL=1
# INSIGHTS_SIGNAL_JOB_CONCURRENCY=4
# INSIGHTS_EST_SEC_PER_JOB=75
# INSIGHTS_VERBOSE_HTTP=1
# INSIGHTS_VERBOSE_CONFIG=1
# INSIGHTS_VERBOSE_DAX=1
# Full LLM prompts (system + user) for clustering and main insights → text files (optional).
# Optional; if unset, prompts log under ./prompt_logs/ (gitignored — IDE may hide the folder).
# Beta: ./prompt_logs/main_insight/beta/batch_<UTC>/*.txt
# INSIGHTS_PROMPT_LOG_DIR=./prompt_logs
# Subfolders: clustering/{why_chunk,merge,draft}/, main_insight/{narrative_full,narrative_chunk,narrative_merge,why_chunk,merge,recommended_actions}/
# Order a run: python scripts/order_prompt_logs.py --root ./prompt_logs

# WHY sweep batching + parallelism (see SignalEngine.compute_whys on ADB)
# INSIGHTS_WHY_DB_FETCH_BATCH=5000
# INSIGHTS_WHY_CACHE_ENTITY_BATCH=400
# INSIGHTS_WHY_CONCURRENCY=16

# Main-insight narrative LLM (Renuity): Swagger ``main_insights_llm`` — Azure OpenAI + optional Anthropic on Azure AI Foundry.
# Sonnet (default deployment name may vary by resource):
# Azure AI Models API — Cohere Command A+ (CRM narrative LLM; ``main_insights_llm=cohere_command_a_plus``)
INSIGHTS_COHERE_AZURE__API_KEY=
INSIGHTS_COHERE_AZURE__ENDPOINT=https://eastus.api.cognitive.microsoft.com/
INSIGHTS_COHERE_AZURE__API_VERSION=2024-05-01-preview
INSIGHTS_COHERE_AZURE__MODEL=Cohere-command-a-plus-05-2026
INSIGHTS_COHERE_MAX_OUTPUT_TOKENS=65536
INSIGHTS_COHERE_THINKING=disabled

# ── Weekly refresh cron (scripts/weekly_refresh_cron.py) ─────────────────────
# API the cron calls for the trigger/generate/refresh steps (the local service).
WEEKLY_REFRESH__API_BASE=http://localhost:8014
# DAX evaluated to resolve the reporting window. Default hits the [Period] measure,
# which returns "DD-MM-YYYY to DD-MM-YYYY". Override only if that measure changes.
# WEEKLY_REFRESH__PERIOD_DAX=EVALUATE ROW("Period", [Period])
# Testing / manual override — skips Power BI entirely when set:
# WEEKLY_REFRESH__PERIOD_OVERRIDE=2026-07-15:2026-07-21
# Window length (days) when the source yields only a single anchor date.
WEEKLY_REFRESH__PERIOD_DAYS=7
# Poll cadence + ceiling while waiting for run-all-signals to finish.
WEEKLY_REFRESH__SIGNAL_POLL_SECONDS=30
WEEKLY_REFRESH__SIGNAL_TIMEOUT_SECONDS=3600
# Per-request timeout for the long LLM steps (generate-standard, refreshes).
WEEKLY_REFRESH__HTTP_TIMEOUT_SECONDS=1800
# Min signals per rep for the finalcrmsalesrep refresh.
WEEKLY_REFRESH__SALES_REP_MIN_SIGNALS=1
# Email (step 7). If host or recipients are unset, email is skipped and logged.
WEEKLY_REFRESH__SMTP_HOST=
WEEKLY_REFRESH__SMTP_PORT=587
WEEKLY_REFRESH__SMTP_STARTTLS=true
WEEKLY_REFRESH__SMTP_USER=
WEEKLY_REFRESH__SMTP_PASSWORD=
WEEKLY_REFRESH__EMAIL_FROM=
WEEKLY_REFRESH__EMAIL_TO=
